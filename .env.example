PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/readasil
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Choose: none, cloudinary, or s3
FILE_STORAGE_PROVIDER=none

# Cloudinary (used when FILE_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Amazon S3 (used when FILE_STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
# Credentials may be supplied by the AWS SDK credential chain or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
